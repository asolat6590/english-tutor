{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,views}/**"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/api/index.js"
    },
    {
      "source": "/login.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
